# Copy this file to android/key.properties and fill in your values.
# NEVER commit key.properties to git — it is in .gitignore.
#
# To generate a keystore (run once, keep the file safe):
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA \
#           -keysize 2048 -validity 10000 -alias upload
#
# Store upload-keystore.jks in the android/ folder (also gitignored).

storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
storeFile=../upload-keystore.jks
